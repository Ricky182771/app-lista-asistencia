rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return get(/databases/$(db)/documents/usuarios/$(request.auth.uid)).data; }
    function isRole(r) { return signedIn() && me().rol == r; }
    function correo() { return request.auth.token.email.lower(); }
    function inv() { return /databases/$(db)/documents/invitaciones/$(correo()); }
    function clase(id) { return get(/databases/$(db)/documents/clases/$(id)).data; }
    // Con sesión y ya dado de alta (tiene usuarios/{uid}), con cualquier rol.
    function registrado() { return signedIn() && exists(/databases/$(db)/documents/usuarios/$(request.auth.uid)); }
    // fecha = "AAAA-MM-DD"
    function fechaTs(fecha) {
      let p = fecha.split('-');
      return timestamp.date(int(p[0]), int(p[1]), int(p[2]));
    }
    // true si la fecha no es futura y cae dentro de los últimos 28 días.
    // Se compara por día contra la fecha UTC con un día de margen (29): la app usa la fecha local
    // de México, que va detrás de UTC, así que hoy−28 local nunca queda fuera a ninguna hora.
    function editable(fecha) {
      return fechaTs(fecha) <= request.time
          && fechaTs(fecha) >= request.time.date() - duration.value(29, 'd');
    }

    match /invitaciones/{email} {
      allow read: if signedIn() && (correo() == email || isRole('admin'));
      allow write: if isRole('admin');
    }

    match /usuarios/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isRole('admin'));
      allow create: if signedIn() && request.auth.uid == uid
        && request.auth.token.email_verified
        && exists(inv())
        && request.resource.data.rol == get(inv()).data.rol
        && request.resource.data.keys().hasOnly(['nombre', 'email', 'fotoUrl', 'rol'])
        && request.resource.data.email == correo()
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() >= 1
        && request.resource.data.nombre.size() <= 100
        && (request.resource.data.get('fotoUrl', null) == null
            || request.resource.data.fotoUrl is string);
      allow update, delete: if isRole('admin');
    }

    match /grupos/{gid} {
      allow read: if isRole('admin') || isRole('orden')
        || (isRole('profesor') && request.auth.uid in resource.data.profesores);
      allow write: if isRole('admin');
      // Modo dual: el encargado de orden activa o quita alumnos en `duales` y no toca nada más.
      allow update: if isRole('orden')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['duales'])
        && request.resource.data.duales is list;
    }

    match /clases/{cid} {
      allow read: if isRole('admin') || isRole('orden')
        || (isRole('profesor') && resource.data.profesorUid == request.auth.uid);
      allow write: if isRole('admin');
    }

    // config/app: la versión publicada del APK para el aviso de actualización. La lee la app de
    // cualquier usuario dado de alta; solo el admin la cambia (por ahora desde la consola de Firebase).
    match /config/{id} {
      allow read: if registrado();
      allow write: if isRole('admin');
    }

    match /pases/{pid} {
      allow read: if isRole('admin') || isRole('orden')
        || (isRole('profesor') && resource.data.profesorUid == request.auth.uid);
      // Pase nuevo: hoy o un día olvidado de los últimos 28, de una clase propia,
      // con el grupo de esa clase y con ID {claseId}_{fecha} (un pase por clase por día)
      allow create: if isRole('profesor')
        && request.resource.data.profesorUid == request.auth.uid
        && editable(request.resource.data.fecha)
        && clase(request.resource.data.claseId).profesorUid == request.auth.uid
        && request.resource.data.grupoId == clase(request.resource.data.claseId).grupoId
        && pid == request.resource.data.claseId + '_' + request.resource.data.fecha;
      // Edición: solo estados y marcas de tiempo, solo los últimos 28 días. marcadoEn queda fijo: un pase
      // del mismo día enviado desde otro dispositivo trae otra hora y se rechaza en vez de reemplazar al
      // original; el reintento de un mismo envío trae la misma hora y sí pasa.
      allow update: if isRole('profesor')
        && resource.data.profesorUid == request.auth.uid
        && editable(resource.data.fecha)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['estados', 'enviadoEn', 'editadoEn']);
      // Reasignar una clase a otro profe (Herramientas del admin): el admin solo puede cambiar el
      // `profesorUid` de un pase, y solo al profe que la clase tiene *al terminar* el WriteBatch
      // (`getAfter`). Así el admin no puede dar un pase a quien no es dueño de la clase, y los
      // rezagados se pueden mover después de reasignar (la clase ya trae al profe nuevo). Todos los
      // pases de un batch son de la misma clase, así que `get`/`getAfter` cuentan una sola vez.
      allow update: if isRole('admin')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['profesorUid'])
        && request.resource.data.profesorUid
             == getAfter(/databases/$(db)/documents/clases/$(resource.data.claseId)).data.profesorUid;
      allow delete: if isRole('admin');
    }
  }
}
