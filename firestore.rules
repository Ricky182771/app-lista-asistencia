rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return get(/databases/$(db)/documents/usuarios/$(request.auth.uid)).data; }
    function isRole(r) { return signedIn() && me().rol == r; }
    function correo() { return request.auth.token.email.lower(); }
    function inv() { return /databases/$(db)/documents/invitaciones/$(correo()); }
    // fecha = "AAAA-MM-DD"
    function fechaTs(fecha) {
      let p = fecha.split('-');
      return timestamp.date(int(p[0]), int(p[1]), int(p[2]));
    }
    // true si la fecha no es futura y cae dentro de los últimos 28 días
    function editable(fecha) {
      return fechaTs(fecha) <= request.time
          && fechaTs(fecha) >= request.time - duration.value(28, 'd');
    }

    match /invitaciones/{email} {
      allow read: if signedIn() && (correo() == email || isRole('admin'));
      allow write: if isRole('admin');
    }

    match /usuarios/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isRole('admin'));
      allow create: if signedIn() && request.auth.uid == uid
        && request.auth.token.email_verified
        && exists(inv())
        && request.resource.data.rol == get(inv()).data.rol
        && request.resource.data.keys().hasOnly(['nombre', 'email', 'fotoUrl', 'rol'])
        && request.resource.data.email == correo()
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() >= 1
        && request.resource.data.nombre.size() <= 100
        && (request.resource.data.get('fotoUrl', null) == null
            || request.resource.data.fotoUrl is string);
      allow update, delete: if isRole('admin');
    }

    match /grupos/{gid} {
      allow read: if isRole('admin') || isRole('orden')
        || (isRole('profesor') && request.auth.uid in resource.data.profesores);
      allow write: if isRole('admin');
    }

    match /clases/{cid} {
      allow read: if isRole('admin') || isRole('orden')
        || (isRole('profesor') && resource.data.profesorUid == request.auth.uid);
      allow write: if isRole('admin');
    }

    match /pases/{pid} {
      allow read: if isRole('admin') || isRole('orden')
        || (isRole('profesor') && resource.data.profesorUid == request.auth.uid);
      // Pase nuevo: hoy o un día olvidado de los últimos 28
      allow create: if isRole('profesor')
        && request.resource.data.profesorUid == request.auth.uid
        && editable(request.resource.data.fecha)
        && get(/databases/$(db)/documents/clases/$(request.resource.data.claseId)).data.profesorUid == request.auth.uid;
      // Edición: solo estados y marcas de tiempo, solo los últimos 28 días
      allow update: if isRole('profesor')
        && resource.data.profesorUid == request.auth.uid
        && editable(resource.data.fecha)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['estados', 'marcadoEn', 'enviadoEn', 'editadoEn']);
      allow delete: if isRole('admin');
    }
  }
}
